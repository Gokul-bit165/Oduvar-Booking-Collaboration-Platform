// Prisma schema for Online Oduvar Booking & Collaboration Platform
// Phase 2: Oduvar Profile System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ODUVAR
  ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OverrideType {
  UNAVAILABLE
  AVAILABLE
}

enum TransportOption {
  INCLUDED
  NOT_INCLUDED
  ADDITIONAL_FEE
  TO_BE_DISCUSSED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  phone        String
  passwordHash String    @map("password_hash")
  role         Role
  profilePhoto String?   @map("profile_photo")
  tokenVersion Int       @default(0) @map("token_version")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  oduvarProfile   OduvarProfile?
  clientBookings  Booking[]        @relation("ClientBookings")
  oduvarBookings  Booking[]        @relation("OduvarBookings")
  sentCollabs     Collaboration[]  @relation("SentCollaborations")
  receivedCollabs Collaboration[]  @relation("ReceivedCollaborations")
  sentMessages    Message[]        @relation("SentMessages")
  reviewsGiven    Review[]         @relation("ClientReviews")
  reviewsReceived Review[]         @relation("OduvarReviews")
  notifications   Notification[]
  reportsFiled    Report[]         @relation("ReportsFiled")

  @@map("users")
}

// =============================================================================
// Phase 2: Oduvar Profile System
// =============================================================================

model OduvarProfile {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @unique @map("user_id") @db.Uuid
  bio                  String?         @db.VarChar(1000)
  location             String?         @db.VarChar(200)
  performanceTypes     String[]        @default([]) @map("performance_types")
  songCategories       String[]        @default([]) @map("song_categories")
  transport            TransportOption @default(TO_BE_DISCUSSED)
  collaborationEnabled Boolean         @default(true) @map("collaboration_enabled")
  // Phase 5: event types the Oduvar has explicitly said they serve (empty until the Oduvar sets it)
  eventTypes           String[]        @default([]) @map("event_types")
  // Phase 4: booking rules + schedule timezone (all schedule times are wall-clock in this IANA zone)
  minimumDurationMinutes Int           @default(30) @map("minimum_duration_minutes")
  maximumDurationMinutes Int           @default(180) @map("maximum_duration_minutes")
  bufferMinutes        Int             @default(0) @map("buffer_minutes")
  timezone             String          @default("Asia/Kolkata")
  isPublished          Boolean         @default(false) @map("is_published")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       OduvarPhoto[]
  skills       OduvarProfileSkill[]
  instruments  OduvarProfileInstrument[]
  availabilities Availability[]
  services     OduvarService[]
  weeklyAvailability OduvarWeeklyAvailability[]
  availabilityOverrides OduvarAvailabilityOverride[]

  @@index([isPublished])
  @@map("oduvar_profiles")
}

model OduvarPhoto {
  id           String        @id @default(uuid()) @db.Uuid
  profileId    String        @map("profile_id") @db.Uuid
  imageUrl     String        @map("image_url")
  displayOrder Int           @default(1) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")

  profile      OduvarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("oduvar_photos")
}

model Skill {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  slug        String               @unique
  isPredefined Boolean             @default(true) @map("is_predefined")
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at")

  profiles    OduvarProfileSkill[]

  @@map("skills")
}

model OduvarProfileSkill {
  profileId String        @map("profile_id") @db.Uuid
  skillId   String        @map("skill_id") @db.Uuid

  profile   OduvarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("oduvar_profile_skills")
}

model Instrument {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String                    @unique
  slug        String                    @unique
  isPredefined Boolean                  @default(true) @map("is_predefined")
  sortOrder   Int                       @default(0) @map("sort_order")
  createdAt   DateTime                  @default(now()) @map("created_at")

  profiles    OduvarProfileInstrument[]

  @@map("instruments")
}

model OduvarProfileInstrument {
  profileId    String        @map("profile_id") @db.Uuid
  instrumentId String        @map("instrument_id") @db.Uuid

  profile      OduvarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([profileId, instrumentId])
  @@index([instrumentId])
  @@map("oduvar_profile_instruments")
}

// =============================================================================
// Phase 3: Services & Pricing
// =============================================================================

model Service {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  category    String          // 'Thevaram', 'Thiruvasagam', 'Thirupugazh', 'Other'
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  oduvarServices OduvarService[]

  @@map("services")
}

model OduvarService {
  id                String           @id @default(uuid()) @db.Uuid
  profileId         String           @map("profile_id") @db.Uuid
  serviceId         String           @map("service_id") @db.Uuid
  customDescription String?          @map("custom_description")
  transport         TransportOption  @default(TO_BE_DISCUSSED)
  transportFee      Decimal?         @map("transport_fee") @db.Decimal(10, 2)
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  profile           OduvarProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  service           Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricings          ServicePricing[]

  @@unique([profileId, serviceId])
  @@index([serviceId, isActive])
  @@map("oduvar_services")
}

model ServicePricing {
  id              String        @id @default(uuid()) @db.Uuid
  oduvarServiceId String        @map("oduvar_service_id") @db.Uuid
  durationMinutes Int           @map("duration_minutes")
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  oduvarService   OduvarService @relation(fields: [oduvarServiceId], references: [id], onDelete: Cascade)

  @@unique([oduvarServiceId, durationMinutes])
  @@map("service_pricings")
}

// =============================================================================
// Phase 4: Availability
// =============================================================================

// One row per working window. A day may have several rows (split shifts).
// Times are "HH:mm" wall-clock strings in the profile's timezone.
model OduvarWeeklyAvailability {
  id        String        @id @default(uuid()) @db.Uuid
  oduvarId  String        @map("oduvar_id") @db.Uuid
  dayOfWeek DayOfWeek     @map("day_of_week")
  startTime String        @map("start_time")
  endTime   String        @map("end_time")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  oduvar    OduvarProfile @relation(fields: [oduvarId], references: [id], onDelete: Cascade)

  @@index([oduvarId, dayOfWeek])
  @@map("oduvar_weekly_availability")
}

// startTime/endTime null => whole day (only valid for UNAVAILABLE).
model OduvarAvailabilityOverride {
  id        String        @id @default(uuid()) @db.Uuid
  oduvarId  String        @map("oduvar_id") @db.Uuid
  date      DateTime      @db.Date
  type      OverrideType
  startTime String?       @map("start_time")
  endTime   String?       @map("end_time")
  reason    String?       @db.VarChar(200)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  oduvar    OduvarProfile @relation(fields: [oduvarId], references: [id], onDelete: Cascade)

  @@index([oduvarId, date])
  @@map("oduvar_availability_overrides")
}

// =============================================================================
// Future Entities (Phases 4–10 stubs)
// =============================================================================

model Availability {
  id        String        @id @default(uuid()) @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  date      DateTime?     @db.Date
  dayOfWeek Int?          @map("day_of_week")
  startTime String        @map("start_time")
  endTime   String        @map("end_time")
  status    String        @default("AVAILABLE")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  profile   OduvarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

// Phase 6: bookings.
// Column naming note: `serviceId` = catalogue Service id, `pricingId` = ServicePricing id,
// `oduvarServiceId` = the Oduvar's OduvarService id, `duration` = duration in minutes,
// `location` = the CLIENT's event location (never the Oduvar's profile location),
// `transport` = the transport option the client acknowledged (the Oduvar's option at booking time).
// There are deliberately NO foreign keys to services/pricing: bookings are historical records that
// must survive an Oduvar editing or deleting a service, so everything needed is snapshotted below.
// Money is Decimal(10,2), same as Phase 3.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  clientId              String        @map("client_id") @db.Uuid
  oduvarId              String        @map("oduvar_id") @db.Uuid // Oduvar USER id
  serviceId             String?       @map("service_id") @db.Uuid
  pricingId             String?       @map("pricing_id") @db.Uuid
  oduvarServiceId       String?       @map("oduvar_service_id") @db.Uuid

  // ── Price snapshot (what was quoted at request time; never re-read from current pricing) ──
  serviceNameSnapshot   String?       @map("service_name_snapshot")
  durationSnapshot      Int?          @map("duration_snapshot")
  serviceAmountSnapshot Decimal?      @map("service_amount_snapshot") @db.Decimal(10, 2)
  transportSnapshot     String?       @map("transport_snapshot")
  transportFeeSnapshot  Decimal?      @map("transport_fee_snapshot") @db.Decimal(10, 2)
  totalAmountSnapshot   Decimal?      @map("total_amount_snapshot") @db.Decimal(10, 2) // null = "To Be Discussed"
  currencySnapshot      String?       @default("INR") @map("currency_snapshot")
  serviceAmount         Decimal?      @map("service_amount") @db.Decimal(10, 2)
  transportFee          Decimal?      @map("transport_fee") @db.Decimal(10, 2)
  totalAmount           Decimal?      @map("total_amount") @db.Decimal(10, 2)
  currency              String        @default("INR")

  // ── When: wall-clock date/time in the Oduvar's timezone (snapshotted) + derived UTC instants ──
  date                  DateTime      @db.Date
  startTime             String        @map("start_time")
  endTime               String?       @map("end_time")
  duration              Int
  timezone              String        @default("Asia/Kolkata")
  startsAt              DateTime?     @map("starts_at")
  endsAt                DateTime?     @map("ends_at")
  blocksUntil           DateTime?     @map("blocks_until") // endsAt + buffer; used by the no-overlap DB constraint

  songType              String        @map("song_type")
  eventType             String        @map("event_type")
  description           String
  location              String
  phone1                String
  phone2                String?
  transport             String
  status                BookingStatus @default(PENDING)
  statusReason          String?       @map("status_reason") @db.VarChar(500)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  confirmedAt           DateTime?     @map("confirmed_at")
  rejectedAt            DateTime?     @map("rejected_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  completedAt           DateTime?     @map("completed_at")

  client      User     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  oduvar      User     @relation("OduvarBookings", fields: [oduvarId], references: [id], onDelete: Cascade)
  reviews     Review[]

  @@index([oduvarId, date, status])
  @@index([clientId, createdAt])
  @@map("bookings")
}

model Collaboration {
  id               String   @id @default(uuid()) @db.Uuid
  senderOduvarId   String   @map("sender_oduvar_id") @db.Uuid
  receiverOduvarId String   @map("receiver_oduvar_id") @db.Uuid
  eventType        String   @map("event_type")
  date             DateTime @db.Date
  time             String
  duration         Int
  location         String
  performanceType  String   @map("performance_type")
  message          String
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sender           User     @relation("SentCollaborations", fields: [senderOduvarId], references: [id], onDelete: Cascade)
  receiver         User     @relation("ReceivedCollaborations", fields: [receiverOduvarId], references: [id], onDelete: Cascade)

  @@map("collaborations")
}

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  participantA String    @map("participant_a") @db.Uuid
  participantB String    @map("participant_b") @db.Uuid
  type         String    @default("DIRECT")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  message        String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  oduvarId  String   @map("oduvar_id") @db.Uuid
  rating    Int
  review    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client    User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  oduvar    User     @relation("OduvarReviews", fields: [oduvarId], references: [id], onDelete: Cascade)

  @@index([oduvarId])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  data      Json?     // e.g. { bookingId } so the app can deep-link
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])

  @@map("notifications")
}

model Report {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter   User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}
